<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:browser="http://namespaces.zope.org/browser"
  xmlns:plone="http://namespaces.plone.org/plone"
  xmlns:zcml="http://namespaces.zope.org/zcml"
  i18n_domain="plone">

    <include package="plone.behavior" file="meta.zcml"/>

    <!-- -*- extra stuff goes here -*- -->

    <plone:behavior
        name="collective.ai.summarizer.ai_summarizable"
        title="AISummarizable"
        description="Provide AI summary capabalities"
        factory=".summarizable.AISummarizable"
        provides=".summarizable.IAISummarizable"
        marker=".summarizable.IAISummarizable"
        />


</configure>
