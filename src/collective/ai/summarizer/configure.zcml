<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
  xmlns:i18n="http://namespaces.zope.org/i18n"
  xmlns:plone="http://namespaces.plone.org/plone"
  i18n_domain="collective.ai.summarizer">

  <i18n:registerTranslations directory="locales"/>

  <!--
    Be careful if you use general includeDependencies, it can have side effects!
    Better import explicit packages or configurations ;)
  -->
  <!--<includeDependencies package="." />-->

  <!-- has to be loaded before permissions are used, so keep above views aso. -->
  <include file="permissions.zcml"/>


  <genericsetup:registerProfile
    name="default"
    title="collective.ai.summarizer"
    directory="profiles/default"
    description="Installs the collective.ai.summarizer add-on."
    provides="Products.GenericSetup.interfaces.EXTENSION"
    post_handler=".setuphandlers.post_install"
  />

  <genericsetup:registerProfile
    name="uninstall"
    title="collective.ai.summarizer (uninstall)"
    directory="profiles/uninstall"
    description="Uninstalls the collective.ai.summarizer add-on."
    provides="Products.GenericSetup.interfaces.EXTENSION"
    post_handler=".setuphandlers.uninstall"
  />

  <utility
    factory=".setuphandlers.HiddenProfiles"
    name="collective.ai.summarizer-hiddenprofiles"
  />

  <!-- -*- extra stuff goes here -*- -->

  <include package=".behaviors"/>
  <include package=".browser"/>

  <adapter
    factory=".adapters.AiSummarizeAdapter"
    provides=".adapters.IAiSummarizeAdapter"
    for="collective.ai.summarizer.behaviors.ai_summarizable.IAiSummarizable"
  />

  <utility
    provides="collective.ai.core.interfaces.IAiActionsProvider"
    factory=".action.SummarizerActions"
    name="summarizer-actions"
  />

  <utility
    name="collective.ai.summarizer.vocabularies.SummarizablePortalTypesVocabulary"
    factory=".vocabularies.SummarizablePortalTypesVocabulary"
  />
</configure>
