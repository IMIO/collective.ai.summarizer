<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:browser="http://namespaces.zope.org/browser"
  xmlns:plone="http://namespaces.plone.org/plone"
  i18n_domain="collective.ai.summarizer">

  <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
  <include package="z3c.jbot" file="meta.zcml"/>
  <browser:jbot
    directory="overrides"
    layer="collective.ai.summarizer.interfaces.ICollectiveAISummarizerLayer"
  />

  <!-- Publish static files -->
  <plone:static
    name="collective.ai.summarizer"
    type="plone"
    directory="static"
  />

  <browser:page
    name="ai-summarizer-action"
    for="*"
    class=".action.AISummarizerAction"
    permission="cmf.ModifyPortalContent"
    layer="collective.ai.summarizer.interfaces.ICollectiveAISummarizerLayer"
    allowed_attributes="available"
  />

  <!--  <utility-->
  <!--    factory=".controlpanel.provide"-->
  <!--    provides="collective.ai.core.interfaces.ICollectiveAIControlPanelFieldProvider"-->
  <!--  />-->

  <browser:page
    name="collective-ai-summarizer-settings"
    for="Products.CMFPlone.interfaces.IPloneSiteRoot"
    class=".controlpanel.AISummarizerControlPanelView"
    permission="cmf.ManagePortal"
    layer="collective.ai.summarizer.interfaces.ICollectiveAISummarizerLayer"
  />

</configure>
